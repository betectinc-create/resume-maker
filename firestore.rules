rules_version = '2';

// Firebase コンソール → Firestore Database → ルール に貼り付けて「公開」してください。
// 「Missing or insufficient permissions.」は、既定の deny ルールのままで
// resumes コレクションへの読み書きが拒否されているために出ます。
//
// 保存されるドキュメント: { uid, name, encryptedData, updatedAt }
// encryptedData は端末側で AES-GCM 暗号化済み。ルールでは本人のみアクセス可に限定します。

service cloud.firestore {
  match /databases/{database}/documents {
    match /resumes/{docId} {
      // 自分のデータだけ読める
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      // 作成時は uid を自分のものに固定させる
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid','name','encryptedData','updatedAt']);

      // 更新・削除は自分のデータのみ
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // 上記以外は全て拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// 補足:
// アプリは where("uid","==",…).orderBy("updatedAt","desc") で検索するため、
// 複合インデックス（uid 昇順 + updatedAt 降順）が必要です。
// 未作成の場合はコンソールにエラーとインデックス作成リンクが出るので、そこから作成してください。
